<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mouse.mes.mapper.StockInItemMapper">
    <select id="findByStockInId" parameterType="java.lang.Long" resultType="com.mouse.mes.entity.StockInItem">
        SELECT * FROM t_stock_in_item WHERE stock_in_id = #{stockInId}
    </select>
    <insert id="insert" parameterType="com.mouse.mes.entity.StockInItem" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_stock_in_item (stock_in_id, material_id, lot_id, quantity, location_id, remark)
        VALUES (#{stockInId}, #{materialId}, #{lotId}, #{quantity}, #{locationId}, #{remark})
    </insert>
    <delete id="deleteByStockInId" parameterType="java.lang.Long">
        DELETE FROM t_stock_in_item WHERE stock_in_id = #{stockInId}
    </delete>
</mapper>
