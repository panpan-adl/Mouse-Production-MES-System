<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mouse.mes.mapper.ProductionReportItemMapper">
    <select id="findByReportId" parameterType="java.lang.Long" resultType="com.mouse.mes.entity.ProductionReportItem">
        SELECT * FROM t_production_report_item WHERE report_id = #{reportId}
    </select>
    <insert id="insert" parameterType="com.mouse.mes.entity.ProductionReportItem">
        INSERT INTO t_production_report_item (report_id, product_id, good_quantity, defective_quantity, defect_type, remark)
        VALUES (#{reportId}, #{productId}, #{goodQuantity}, #{defectiveQuantity}, #{defectType}, #{remark})
    </insert>
    <delete id="deleteByReportId" parameterType="java.lang.Long">
        DELETE FROM t_production_report_item WHERE report_id = #{reportId}
    </delete>
</mapper>
