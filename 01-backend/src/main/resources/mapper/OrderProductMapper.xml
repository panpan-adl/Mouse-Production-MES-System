<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mouse.mes.mapper.OrderProductMapper">
    <select id="findAll" resultType="com.mouse.mes.entity.OrderProduct">
        SELECT * FROM t_order_product
    </select>
    <select id="findById" parameterType="Long" resultType="com.mouse.mes.entity.OrderProduct">
        SELECT * FROM t_order_product WHERE id = #{id}
    </select>
    <select id="findByOrderId" parameterType="Long" resultType="com.mouse.mes.entity.OrderProduct">
        SELECT * FROM t_order_product WHERE order_id = #{orderId}
    </select>
    <insert id="insert" parameterType="com.mouse.mes.entity.OrderProduct">
        INSERT INTO t_order_product (order_id, product_id, product_name, quantity, unit_price, subtotal, remark)
        VALUES (#{orderId}, #{productId}, #{productName}, #{quantity}, #{unitPrice}, #{subtotal}, #{remark})
    </insert>
    <update id="update" parameterType="com.mouse.mes.entity.OrderProduct">
        UPDATE t_order_product SET
        order_id = #{orderId},
        product_id = #{productId},
        product_name = #{productName},
        quantity = #{quantity},
        unit_price = #{unitPrice},
        subtotal = #{subtotal},
        remark = #{remark}
        WHERE id = #{id}
    </update>
    <delete id="delete" parameterType="Long">
        DELETE FROM t_order_product WHERE id = #{id}
    </delete>
    <delete id="deleteByOrderId" parameterType="Long">
        DELETE FROM t_order_product WHERE order_id = #{orderId}
    </delete>
</mapper>