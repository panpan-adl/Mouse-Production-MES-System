<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mouse.mes.mapper.StockOutItemMapper">
    <select id="findByStockOutId" parameterType="java.lang.Long" resultType="com.mouse.mes.entity.StockOutItem">
        SELECT * FROM t_stock_out_item WHERE stock_out_id = #{stockOutId}
    </select>
    <insert id="insert" parameterType="com.mouse.mes.entity.StockOutItem" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_stock_out_item (stock_out_id, material_id, lot_id, quantity, location_id, remark)
        VALUES (#{stockOutId}, #{materialId}, #{lotId}, #{quantity}, #{locationId}, #{remark})
    </insert>
    <delete id="deleteByStockOutId" parameterType="java.lang.Long">
        DELETE FROM t_stock_out_item WHERE stock_out_id = #{stockOutId}
    </delete>
</mapper>
