.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f7fa;
}

.task-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.task-no {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.task-status {
  font-size: 26rpx;
  font-weight: 500;
  padding: 8rpx 20rpx;
  background: rgba(24, 144, 255, 0.1);
  border-radius: 20rpx;
}

.detail-section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #1890ff;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 26rpx;
  color: #999;
}

.value {
  font-size: 26rpx;
  color: #333;
}

.report-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.report-item {
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 8rpx;
}

.report-header {
  margin-bottom: 8rpx;
}

.report-date {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.report-info {
  font-size: 24rpx;
  color: #333;
}

.actions {
  margin-top: 30rpx;
}

.action-btn {
  width: 100%;
  padding: 24rpx 0;
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.loading-icon {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
