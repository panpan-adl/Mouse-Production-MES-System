<view class="container">
  <view class="header">
    <text class="title">生产任务</text>
  </view>

  <view class="filter-bar">
    <view 
      class="filter-item {{ statusFilter === item.value ? 'active' : '' }}" 
      wx:for="{{ statusOptions }}" 
      wx:key="value"
      bindtap="onStatusChange"
      data-value="{{ item.value }}"
    >
      {{ item.label }}
    </view>
  </view>

  <view class="task-list" wx:if="{{ !loading && tasks.length > 0 }}">
    <view class="task-card" wx:for="{{ tasks }}" wx:key="id" bindtap="goToDetail" data-id="{{ item.id }}">
      <view class="task-header">
        <text class="task-no">{{ item.taskNo }}</text>
        <view class="task-status" style="color: {{ getStatusColor(item.status) }}; background: {{ getStatusBgColor(item.status) }}">
          {{ getStatusText(item.status) }}
        </view>
      </view>
      <view class="task-info">
        <view class="info-row">
          <text class="info-label">计划编号:</text>
          <text class="info-value">{{ item.planNo || '-' }}</text>
        </view>
        <view class="info-row">
          <text class="info-label">产品名称:</text>
          <text class="info-value">{{ item.productName || '未知产品' }}</text>
        </view>
        <view class="info-row">
          <text class="info-label">任务类型:</text>
          <text class="info-value">{{ item.taskType || '-' }}</text>
        </view>
        <view class="info-row">
          <text class="info-label">目标数量:</text>
          <text class="info-value">{{ item.targetQuantity || 0 }}</text>
        </view>
        <view class="info-row">
          <text class="info-label">已完成:</text>
          <text class="info-value">{{ item.completedQuantity || 0 }}</text>
        </view>
      </view>
      <view class="task-footer">
        <text class="task-time">{{ formatDate(item.createdAt) }}</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{ !loading && tasks.length === 0 }}">
    <view class="empty-icon">🔧</view>
    <text class="empty-text">暂无生产任务</text>
  </view>

  <view class="loading" wx:if="{{ loading }}">
    <view class="loading-icon"></view>
    <text>加载中...</text>
  </view>
</view>
