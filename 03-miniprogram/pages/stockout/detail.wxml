<view class="page">
  <view class="loading" wx:if="loading">
    <text>加载中...</text>
  </view>

  <view class="content" wx:else>
    <view class="card">
      <view class="card-header">
        <text class="card-title">{{stockOut.stockOutNo}}</text>
        <text class="status-tag {{stockOut.status}}">{{getStatusText(stockOut.status)}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">出库类型</text>
        <text class="form-value">{{stockOut.stockOutType || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">仓库名称</text>
        <text class="form-value">{{warehouse.warehouseName || '未知'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">来源订单</text>
        <text class="form-value">{{stockOut.sourceOrderNo || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">出库数量</text>
        <text class="form-value highlight">{{stockOut.totalQuantity || 0}} 件</text>
      </view>
      <view class="form-item">
        <text class="form-label">备注</text>
        <text class="form-value">{{stockOut.remark || '-'}}</text>
      </view>
    </view>

    <view class="card" wx:if="stockOut.items && stockOut.items.length > 0">
      <view class="card-header">
        <text class="card-title">出库明细</text>
      </view>
      <view class="table">
        <view class="table-header">
          <text class="th">物料名称</text>
          <text class="th">数量</text>
          <text class="th">批次</text>
        </view>
        <view class="table-row" wx:for="{{stockOut.items}}" wx:key="id">
          <text class="td">{{getMaterialName(item.materialId)}}</text>
          <text class="td">{{item.quantity}}</text>
          <text class="td">{{item.lotId || '-'}}</text>
        </view>
      </view>
    </view>

    <view class="bottom-btn">
      <button class="action-btn" bindtap="goBack">返回</button>
    </view>
  </view>
</view>