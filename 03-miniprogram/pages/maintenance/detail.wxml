<view class="page">
  <view class="loading" wx:if="loading">
    <text>加载中...</text>
  </view>

  <view class="content" wx:else>
    <view class="card">
      <view class="card-header">
        <text class="card-title">{{equipment.equipmentName}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">维护类型</text>
        <text class="form-value">{{maintenance.maintenanceType || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">维护状态</text>
        <text class="form-value">{{getStatusText(maintenance.status)}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">计划开始时间</text>
        <text class="form-value">{{maintenance.planStartTime || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">计划结束时间</text>
        <text class="form-value">{{maintenance.planEndTime || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">实际开始时间</text>
        <text class="form-value">{{maintenance.actualStartTime || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">实际结束时间</text>
        <text class="form-value">{{maintenance.actualEndTime || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">维护内容</text>
        <text class="form-value">{{maintenance.maintenanceContent || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">备注</text>
        <text class="form-value">{{maintenance.remark || '-'}}</text>
      </view>
    </view>

    <view class="bottom-btn">
      <button class="action-btn" bindtap="goBack">返回</button>
    </view>
  </view>
</view>