<view class="page">
  <view class="search-bar">
    <view class="search-input-wrap">
      <input class="search-input" placeholder="搜索维护单..." value="{{searchText}}" bindinput="searchInput"/>
    </view>
  </view>

  <view class="content">
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">{{maintenances.length}}</text>
        <text class="stat-label">维护单</text>
      </view>
    </view>

    <view class="list" wx:if="!loading">
      <view class="list-item" wx:for="{{maintenances}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="item-left">
          <text class="item-title">{{getEquipmentName(item.equipmentId)}}</text>
          <text class="item-subtitle">{{item.maintenanceType || '-'}}</text>
        </view>
        <view class="item-right">
          <text class="status-tag {{item.status}}">{{getStatusText(item.status)}}</text>
        </view>
      </view>
      <view class="empty" wx:if="{{maintenances.length === 0}}">
        <text>暂无维护单</text>
      </view>
    </view>

    <view class="loading" wx:if="loading">
      <text>加载中...</text>
    </view>
  </view>

  <view class="bottom-btn">
    <button class="action-btn primary" bindtap="addMaintenance">新增维护单</button>
  </view>
</view>