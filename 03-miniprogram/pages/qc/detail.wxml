<view class="page">
  <view class="loading" wx:if="loading">
    <text>加载中...</text>
  </view>

  <view class="content" wx:else>
    <view class="card">
      <view class="card-header">
        <text class="card-title">{{inspection.inspectionNo}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">质检类型</text>
        <text class="form-value">{{getTypeText(inspection.inspectionType)}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">来源订单</text>
        <text class="form-value">{{inspection.sourceOrderNo || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">检验数量</text>
        <text class="form-value">{{inspection.sampleQuantity || 0}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">合格数量</text>
        <text class="form-value">{{inspection.qualifiedQuantity || 0}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">不合格数量</text>
        <text class="form-value">{{inspection.defectiveQuantity || 0}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">合格率</text>
        <text class="form-value highlight">{{inspection.qualifiedRate || 0}}%</text>
      </view>
      <view class="form-item">
        <text class="form-label">质检结果</text>
        <text class="form-value">{{getResultText(inspection.result)}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">不合格原因</text>
        <text class="form-value">{{inspection.defectReason || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">处理方式</text>
        <text class="form-value">{{inspection.handleMethod || '-'}}</text>
      </view>
    </view>

    <view class="bottom-btn">
      <button class="action-btn" bindtap="goBack">返回</button>
    </view>
  </view>
</view>