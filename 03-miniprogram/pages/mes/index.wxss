.page{padding:24rpx;background:#f5f7fb;min-height:100vh}.tabs,.actions{display:flex;gap:12rpx;flex-wrap:wrap}.card{background:#fff;border-radius:18rpx;padding:24rpx;margin:20rpx 0;line-height:1.8;color:#334155}.title{font-size:30rpx;font-weight:600;color:#0f172a}.actions{margin-top:16rpx}.error{background:#fff1f2;color:#be123c;padding:20rpx;border-radius:12rpx}.empty,.hint{color:#64748b;padding:20rpx}.measure{border-top:1rpx solid #e2e8f0;padding:20rpx 0}input{border:1rpx solid #cbd5e1;padding:16rpx;margin:16rpx 0;border-radius:10rpx}picker{padding:12rpx 0;color:#2563eb}button{margin-top:12rpx}
