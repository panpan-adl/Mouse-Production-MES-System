<view class="page">
  <button size="mini" bindtap="scan">扫码识别工作站 / 包装箱</button>
  <view class="tabs"><button size="mini" data-tab="tasks" bindtap="switchTab">工序任务</button><button wx:if="{{role===1||role===2||role===3||role===4||role===5||role===9}}" size="mini" data-tab="reports" bindtap="switchTab">报工审批结果</button><button size="mini" data-tab="calendar" bindtap="switchTab">我的排班</button><button wx:if="{{role===8||role===9}}" size="mini" data-tab="checks" bindtap="switchTab">点检保养</button></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <block wx:if="{{tab==='tasks'}}"><view class="card" wx:for="{{tasks}}" wx:key="id"><view class="title">{{item.task_no}} · {{item.operation_name}}</view><view>{{item.station_name}} · {{item.assigned_user_name}} · {{item.state}}</view><view>计划量 {{item.quantity}} · {{item.start_at||'尚未排产'}}</view><view class="actions"><button size="mini" data-id="{{item.id}}" bindtap="sop">工序SOP</button><button wx:if="{{item.canReport}}" size="mini" data-id="{{item.id}}" bindtap="start" disabled="{{busy}}">开工</button><button wx:if="{{item.canReport}}" size="mini" data-id="{{item.id}}" bindtap="report">报工</button><button wx:if="{{(role===4||role===9)&&item.task_status!==4&&item.task_status!==5}}" size="mini" data-id="{{item.id}}" bindtap="inspect">质量检验</button></view></view><view wx:if="{{!tasks.length}}" class="empty">当前岗位没有可显示的工序任务。</view></block>
  <view wx:if="{{reportId}}" class="card"><view class="title">提交报工单，待主管确认</view><input type="number" value="{{quantity}}" data-field="quantity" bindinput="input" placeholder="合格品数量"/><input type="number" value="{{badQuantity}}" data-field="badQuantity" bindinput="input" placeholder="不良品数量"/><button bindtap="submitReport" disabled="{{busy}}">提交报工</button></view>
  <view wx:if="{{selected}}" class="card"><view class="title">{{selected.task_no}} 检验</view><picker range="{{templateOptions}}" range-key="display" value="{{templateIndex}}" bindchange="templateChanged"><view>模板：{{templateOptions[templateIndex].display||'无适用模板'}}</view></picker><input type="number" value="{{quantity}}" data-field="quantity" bindinput="input" placeholder="检验/抽检数量"/><view wx:for="{{results}}" wx:key="id" class="measure"><view>{{item.name}} · {{item.standard}}</view><input value="{{item.actual}}" data-index="{{index}}" bindinput="actualChanged" placeholder="实测数字或现象"/><picker range="{{['合格','不合格']}}" data-index="{{index}}" bindchange="verdictChanged"><view>判定：{{item.result==='PASS'?'合格':'不合格'}}</view></picker></view><view class="hint">数值检测项由服务端按上下限判定，人工选择不能覆盖超限结果。</view><button bindtap="submitInspection" disabled="{{busy}}">保存检验</button></view>
  <block wx:if="{{tab==='reports'}}"><view class="card" wx:for="{{reports}}" wx:key="id"><view class="title">{{item.code}} · {{item.task_no}}</view><view>合格 {{item.good_quantity}} · 不良 {{item.bad_quantity}}</view><view>{{item.status==='PENDING'?'待主管确认':item.status==='CONFIRMED'?'已确认并扣料':'已驳回'}} · {{item.approval_note||''}}</view></view></block>
  <block wx:if="{{tab==='calendar'}}"><view class="card" wx:for="{{calendar}}" wx:key="id"><view class="title">{{item.team_name}} · {{item.station_name}}</view><view>{{item.start_at}} — {{item.end_at}}</view></view><view wx:if="{{!calendar.length}}" class="empty">暂无排班。</view></block>
  <block wx:if="{{tab==='checks'}}"><view class="card" wx:for="{{checks}}" wx:key="id"><view class="title">{{item.name}} · {{item.equipment_name}}</view><view>应执行日期：{{item.due_date}} · {{item.status==='DONE'?'已完成':item.status==='OVERDUE'?'逾期':'待执行'}}</view><view>{{item.standard}}</view><button wx:if="{{item.status!=='DONE'}}" size="mini" data-id="{{item.id}}" data-plan="{{item.plan_id}}" bindtap="openCheck">填写结果</button></view><view wx:if="{{checkId}}" class="card"><input value="{{actual}}" data-field="actual" bindinput="input" placeholder="实际点检/保养情况"/><picker range="{{['正常','异常，自动报修']}}" bindchange="checkVerdict"><view>{{checkResult==='PASS'?'正常':'异常，自动报修'}}</view></picker><button bindtap="recordCheck" disabled="{{busy}}">提交执行结果</button></view></block>
</view>
