<view class="container">
  <view class="order-card" wx:if="{{ !loading && order }}">
    <view class="order-header">
      <text class="order-no">{{ order.orderNo }}</text>
      <view class="order-status" style="color: {{ getStatusColor(order.orderStatus) }}">
        {{ getStatusText(order.orderStatus) }}
      </view>
    </view>

    <view class="detail-section">
      <view class="section-title">基本信息</view>
      <view class="detail-row">
        <text class="label">客户名称</text>
        <text class="value">{{ order.customerName || '-' }}</text>
      </view>
      <view class="detail-row">
        <text class="label">产品名称</text>
        <text class="value">{{ order.productName || '-' }}</text>
      </view>
      <view class="detail-row">
        <text class="label">产品型号</text>
        <text class="value">{{ order.productModel || '-' }}</text>
      </view>
      <view class="detail-row">
        <text class="label">订单数量</text>
        <text class="value">{{ order.quantity || 0 }}</text>
      </view>
      <view class="detail-row">
        <text class="label">单价</text>
        <text class="value">{{ order.unitPrice || 0 }}</text>
      </view>
      <view class="detail-row">
        <text class="label">总金额</text>
        <text class="value total">{{ order.totalAmount || 0 }}</text>
      </view>
    </view>

    <view class="detail-section">
      <view class="section-title">时间信息</view>
      <view class="detail-row">
        <text class="label">创建时间</text>
        <text class="value">{{ formatDate(order.createTime) }}</text>
      </view>
      <view class="detail-row">
        <text class="label">更新时间</text>
        <text class="value">{{ formatDate(order.updateTime) }}</text>
      </view>
      <view class="detail-row">
        <text class="label">要求交货期</text>
        <text class="value">{{ formatDate(order.deliveryDate) }}</text>
      </view>
    </view>

    <view class="detail-section">
      <view class="section-title">其他信息</view>
      <view class="detail-row">
        <text class="label">备注</text>
        <text class="value">{{ order.remark || '-' }}</text>
      </view>
    </view>

    <view class="actions" wx:if="{{ order.orderStatus === 0 }}">
      <button class="action-btn confirm" bindtap="confirmOrder">确认订单</button>
      <button class="action-btn cancel" bindtap="cancelOrder">取消订单</button>
    </view>

    <view class="actions" wx:elif="{{ order.orderStatus === 1 }}">
      <button class="action-btn primary" bindtap="generatePlan">生成生产计划</button>
    </view>

    <view class="actions">
      <button class="action-btn barcode" bindtap="generateBarcode">生成条码</button>
    </view>
  </view>

  <view class="barcode-modal" wx:if="{{ showBarcodeModal }}" bindtap="closeBarcodeModal">
    <view class="barcode-content" catchtap="noop">
      <view class="barcode-header">
        <text class="barcode-title">订单条码</text>
        <text class="barcode-close" bindtap="closeBarcodeModal">×</text>
      </view>
      <view class="barcode-canvas-wrap">
        <canvas canvas-id="barcodeCanvas" class="barcode-canvas" width="600" height="240"></canvas>
      </view>
      <view class="barcode-info">
        <text class="barcode-order-no">{{ order.orderNo }}</text>
      </view>
      <view class="barcode-actions">
        <button class="save-btn" bindtap="saveBarcode">保存到相册</button>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{ loading }}">
    <view class="loading-icon"></view>
    <text>加载中...</text>
  </view>

  <view class="empty" wx:if="{{ !loading && !order }}">
    <text>订单不存在</text>
    <button bindtap="goBack">返回</button>
  </view>
</view>
