<view class="page">
  <view class="loading" wx:if="loading">
    <text>加载中...</text>
  </view>

  <view class="content" wx:else>
    <view class="card">
      <view class="card-header">
        <text class="card-title">{{equipment.equipmentName}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">设备编码</text>
        <text class="form-value">{{equipment.equipmentCode || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">设备类型</text>
        <text class="form-value">{{equipment.equipmentType || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">设备状态</text>
        <text class="form-value">{{getStatusText(equipment.status)}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">所在车间</text>
        <text class="form-value">{{equipment.workshopId || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">购买日期</text>
        <text class="form-value">{{equipment.purchaseDate || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">使用年限</text>
        <text class="form-value">{{equipment.serviceLife || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">备注</text>
        <text class="form-value">{{equipment.remark || '-'}}</text>
      </view>
    </view>

    <view class="bottom-btn">
      <button class="action-btn" bindtap="goBack">返回</button>
    </view>
  </view>
</view>