.container {
  padding: 0;
  min-height: 100vh;
  background-color: #f5f7fa;
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.header {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  padding: 40rpx 30rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  margin-top: 24rpx;
  margin-left: 16rpx;
  margin-right: 16rpx;
  color: #fff;
}

.greeting {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.hello {
  font-size: 28rpx;
}

.username {
  font-size: 36rpx;
  font-weight: 600;
  margin-left: 8rpx;
}

.date {
  font-size: 24rpx;
  opacity: 0.8;
}

.stats-section {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 16rpx;
  background: #fff;
}

.progress-ring-card {
  flex-shrink: 0;
  padding: 0;
}

.ring-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.progress-ring {
  width: 160rpx;
  height: 160rpx;
}

.ring-center {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ring-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1890ff;
}

.ring-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.stats-grid {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.stat-card {
  padding: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  cursor: pointer;
}

.stat-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 16rpx;
}

.order-icon { background: #e6f7ff; }
.plan-icon { background: #f6ffed; }
.task-icon { background: #fff7e6; }
.wo-icon { background: #f9f0ff; }

.stat-info {
  flex: 1;
}

.stat-value-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.stat-trend {
  font-size: 22rpx;
  color: #52c41a;
}

.stat-trend.down {
  color: #ff4d4f;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.chart-section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #1890ff;
}

.chart-card {
  background: #fff;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  margin: 0 16rpx;
}

.trend-chart {
  width: 100%;
  height: 280rpx;
}

.todo-section {
  background: #fff;
  margin: 0 16rpx 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.todo-count {
  font-size: 24rpx;
  color: #1890ff;
  background: rgba(24, 144, 255, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.todo-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.todo-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.todo-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.todo-checkbox.checked {
  background: #1890ff;
  border-color: #1890ff;
}

.todo-checkbox.checked text {
  color: #fff;
  font-size: 24rpx;
}

.todo-content {
  flex: 1;
}

.todo-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.todo-title.completed {
  color: #999;
  text-decoration: line-through;
}

.todo-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.todo-priority {
  font-size: 20rpx;
  color: #fff;
  background: #ff4d4f;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.empty-todo {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
}

.quick-links {
  background: #fff;
  margin: 0 16rpx 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.links-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.link-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.link-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.link-icon {
  font-size: 40rpx;
}

.link-name {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.recent-orders {
  background: #fff;
  margin: 0 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.order-list {
  display: flex;
  flex-direction: column;
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-item:last-child {
  border-bottom: none;
}

.order-info {
  flex: 1;
}

.order-no {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.order-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.order-status-badge {
  font-size: 24rpx;
  font-weight: 500;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.login-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  background: #fff;
  margin: 0 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tip-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.tip-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.login-btn {
  background: #1890ff;
  color: #fff;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.loading-icon {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
