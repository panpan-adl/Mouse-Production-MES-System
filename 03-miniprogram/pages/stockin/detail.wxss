.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.content {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8f9fa;
  padding: 24rpx;
  border-bottom: 1rpx solid #eee;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.status-tag {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.status-tag.PENDING {
  background: #fff7e6;
  color: #fa8c16;
}

.status-tag.APPROVED {
  background: #e6f7ff;
  color: #1890ff;
}

.status-tag.COMPLETED {
  background: #f6ffed;
  color: #52c41a;
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #666;
}

.form-value {
  font-size: 28rpx;
  color: #333;
}

.form-value.highlight {
  font-size: 36rpx;
  font-weight: bold;
  color: #52c41a;
}

.table {
  padding: 0 24rpx;
}

.table-header {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.th {
  flex: 1;
  font-size: 26rpx;
  color: #999;
  text-align: center;
}

.table-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.table-row:last-child {
  border-bottom: none;
}

.td {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
}