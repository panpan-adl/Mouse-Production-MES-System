<view class="page">
  <view class="search-bar">
    <view class="search-input-wrap">
      <input class="search-input" placeholder="搜索入库单号..." value="{{searchText}}" bindinput="searchInput"/>
    </view>
  </view>

  <view class="content">
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">{{stockIns.length}}</text>
        <text class="stat-label">入库单</text>
      </view>
    </view>

    <view class="list" wx:if="!loading">
      <view class="list-item" wx:for="{{stockIns}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="item-left">
          <text class="item-title">{{item.stockInNo}}</text>
          <text class="item-subtitle">仓库: {{getWarehouseName(item.warehouseId)}}</text>
        </view>
        <view class="item-right">
          <text class="status-tag {{item.status}}">{{getStatusText(item.status)}}</text>
        </view>
      </view>
      <view class="empty" wx:if="{{stockIns.length === 0}}">
        <text>暂无入库单</text>
      </view>
    </view>

    <view class="loading" wx:if="loading">
      <text>加载中...</text>
    </view>
  </view>

  <view class="bottom-btn">
    <button class="action-btn primary" bindtap="addStockIn">新增入库单</button>
  </view>
</view>