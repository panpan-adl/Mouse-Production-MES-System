<view class="page">
  <view class="loading" wx:if="loading">
    <text>加载中...</text>
  </view>

  <view class="content" wx:else>
    <view class="card">
      <view class="card-header">
        <text class="card-title">{{stockIn.stockInNo}}</text>
        <text class="status-tag {{stockIn.status}}">{{getStatusText(stockIn.status)}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">入库类型</text>
        <text class="form-value">{{stockIn.stockInType || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">仓库名称</text>
        <text class="form-value">{{warehouse.warehouseName || '未知'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">来源订单</text>
        <text class="form-value">{{stockIn.sourceOrderNo || '-'}}</text>
      </view>
      <view class="form-item">
        <text class="form-label">入库数量</text>
        <text class="form-value highlight">{{stockIn.totalQuantity || 0}} 件</text>
      </view>
      <view class="form-item">
        <text class="form-label">备注</text>
        <text class="form-value">{{stockIn.remark || '-'}}</text>
      </view>
    </view>

    <view class="card" wx:if="stockIn.items && stockIn.items.length > 0">
      <view class="card-header">
        <text class="card-title">入库明细</text>
      </view>
      <view class="table">
        <view class="table-header">
          <text class="th">物料名称</text>
          <text class="th">数量</text>
          <text class="th">批次</text>
        </view>
        <view class="table-row" wx:for="{{stockIn.items}}" wx:key="id">
          <text class="td">{{getMaterialName(item.materialId)}}</text>
          <text class="td">{{item.quantity}}</text>
          <text class="td">{{item.lotId || '-'}}</text>
        </view>
      </view>
    </view>

    <view class="bottom-btn">
      <button class="action-btn" bindtap="goBack">返回</button>
    </view>
  </view>
</view>