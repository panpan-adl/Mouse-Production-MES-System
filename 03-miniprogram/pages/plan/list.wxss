.container {
  padding: 0;
  min-height: 100vh;
  background-color: #f5f7fa;
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.view-switch {
  display: flex;
  background: #f5f7fa;
  border-radius: 24rpx;
  padding: 6rpx;
}

.switch-item {
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  border-radius: 20rpx;
  transition: all 0.3s;
}

.switch-item.active {
  background: #1890ff;
  color: #fff;
}

.search-section {
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  background: transparent;
}

.search-clear {
  font-size: 32rpx;
  color: #999;
  padding: 0 8rpx;
}

.filter-bar {
  background: #fff;
  padding: 12rpx 0;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-inner {
  display: inline-flex;
  padding: 0 20rpx;
  gap: 16rpx;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f7fa;
  border-radius: 24rpx;
  white-space: nowrap;
}

.filter-item.active {
  background: #1890ff;
  color: #fff;
}

.filter-count {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.3);
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}

.plan-list {
  display: flex;
  flex-direction: column;
}

.plan-card {
  background: #fff;
  margin: 0 16rpx 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.plan-left {
  flex: 1;
}

.plan-no {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.plan-tags {
  display: flex;
  gap: 12rpx;
}

.plan-status {
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.priority-tag {
  font-size: 20rpx;
  color: #ff4d4f;
  background: rgba(255, 77, 79, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.plan-progress-ring {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-value {
  font-size: 20rpx;
  font-weight: 600;
  color: #333;
}

.plan-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  align-items: center;
}

.info-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  width: 80rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.info-percent {
  font-size: 24rpx;
  font-weight: 600;
}

.progress-bar-section {
  padding: 16rpx 0;
}

.progress-bar-bg {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.plan-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
}

.plan-time {
  font-size: 24rpx;
  color: #999;
}

.plan-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 28rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.action-btn.delete {
  background: #f5f5f5;
  color: #666;
}

.gantt-view {
  background: #fff;
  margin: 0 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.gantt-header {
  display: flex;
  padding: 20rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #f0f0f0;
}

.gantt-label-col {
  width: 180rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
}

.gantt-timeline {
  flex: 1;
  display: flex;
  justify-content: center;
}

.timeline-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
}

.gantt-body {
  padding: 12rpx 0;
}

.gantt-row {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.gantt-row:last-child {
  border-bottom: none;
}

.gantt-label {
  width: 180rpx;
  flex-shrink: 0;
}

.gantt-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.gantt-sub {
  font-size: 22rpx;
  color: #999;
}

.gantt-bar-container {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.gantt-bar-bg {
  flex: 1;
  height: 24rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.gantt-bar-fill {
  height: 100%;
  border-radius: 12rpx;
  transition: width 0.5s ease;
}

.gantt-percent {
  font-size: 24rpx;
  font-weight: 600;
  width: 60rpx;
  text-align: right;
}

.gantt-status {
  width: 80rpx;
  font-size: 22rpx;
  font-weight: 500;
  text-align: right;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.loading-icon {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
