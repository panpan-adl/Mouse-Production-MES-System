<view class="profile-container">
  <view class="profile-header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="avatar-wrap">
        <image class="avatar" src="/images/logo.png" mode="aspectFit"></image>
      </view>
      <view class="user-info">
        <text class="real-name">{{ userInfo.realName || userInfo.username || '用户' }}</text>
        <text class="role-name">{{ userInfo.roleName || '普通用户' }}</text>
      </view>
      <view class="header-actions">
        <view class="action-btn" bindtap="onNotifications">
          <text class="action-icon">🔔</text>
          <text class="action-badge" wx:if="{{ notificationCount > 0 }}">{{ notificationCount }}</text>
        </view>
        <view class="action-btn" bindtap="onFavorites">
          <text class="action-icon">⭐</text>
          <text class="action-badge" wx:if="{{ favoriteCount > 0 }}">{{ favoriteCount }}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="stats-card">
    <view class="stats-title">📊 工作统计</view>
    <view class="stats-grid">
      <view class="stat-item" bindtap="goToPage" data-url="/pages/order/list">
        <text class="stat-value">{{ stats.totalOrders }}</text>
        <text class="stat-label">总订单</text>
      </view>
      <view class="stat-item highlight" bindtap="goToPage" data-url="/pages/order/list">
        <text class="stat-value">{{ stats.pendingOrders }}</text>
        <text class="stat-label">待确认</text>
      </view>
      <view class="stat-item success" bindtap="goToPage" data-url="/pages/order/list">
        <text class="stat-value">{{ stats.completedOrders }}</text>
        <text class="stat-label">已完成</text>
      </view>
      <view class="stat-item" bindtap="goToPage" data-url="/pages/plan/list">
        <text class="stat-value">{{ stats.totalPlans }}</text>
        <text class="stat-label">生产计划</text>
      </view>
      <view class="stat-item warning" bindtap="goToPage" data-url="/pages/plan/list">
        <text class="stat-value">{{ stats.inProgressPlans }}</text>
        <text class="stat-label">进行中</text>
      </view>
      <view class="stat-item" bindtap="goToPage" data-url="/pages/workorder/list">
        <text class="stat-value">{{ stats.myWorkOrders }}</text>
        <text class="stat-label">我的工单</text>
      </view>
    </view>
  </view>

  <view class="profile-card">
    <view class="card-title">基本信息</view>
    <view class="info-item">
      <text class="info-icon">🆔</text>
      <text class="info-label">用户编码</text>
      <text class="info-value">{{ userInfo.userCode || '-' }}</text>
    </view>
    <view class="info-item">
      <text class="info-icon">📱</text>
      <text class="info-label">手机号</text>
      <text class="info-value">{{ userInfo.phone || '-' }}</text>
    </view>
    <view class="info-item">
      <text class="info-icon">✉️</text>
      <text class="info-label">邮箱</text>
      <text class="info-value">{{ userInfo.email || '-' }}</text>
    </view>
    <view class="info-item">
      <text class="info-icon">🏢</text>
      <text class="info-label">部门</text>
      <text class="info-value">{{ userInfo.deptName || '-' }}</text>
    </view>
  </view>

  <view class="profile-card">
    <view class="card-title">系统设置</view>
    <view class="menu-item" bindtap="onChangePassword">
      <view class="menu-icon">🔒</view>
      <text class="menu-text">修改密码</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="onHelp">
      <view class="menu-icon">❓</view>
      <text class="menu-text">帮助中心</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="onFeedback">
      <view class="menu-icon">💬</view>
      <text class="menu-text">意见反馈</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="onAbout">
      <view class="menu-icon">ℹ️</view>
      <text class="menu-text">关于系统</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item danger" bindtap="onLogout">
      <view class="menu-icon">🚪</view>
      <text class="menu-text">退出登录</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <view class="quick-actions">
    <view class="quick-action-item" bindtap="goToPage" data-url="/pages/order/list">
      <view class="quick-icon order-icon">📋</view>
      <text class="quick-label">订单管理</text>
    </view>
    <view class="quick-action-item" bindtap="goToPage" data-url="/pages/plan/list">
      <view class="quick-icon plan-icon">📊</view>
      <text class="quick-label">生产计划</text>
    </view>
    <view class="quick-action-item" bindtap="goToPage" data-url="/pages/workorder/list">
      <view class="quick-icon wo-icon">🔧</view>
      <text class="quick-label">工单管理</text>
    </view>
  </view>

  <view class="version-info">
    <text>版本 1.0.0</text>
  </view>
</view>
