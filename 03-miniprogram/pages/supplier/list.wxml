<view class="page">
  <view class="search-bar">
    <view class="search-input-wrap">
      <input class="search-input" placeholder="搜索供应商..." value="{{searchText}}" bindinput="searchInput"/>
    </view>
  </view>

  <view class="content">
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">{{suppliers.length}}</text>
        <text class="stat-label">供应商</text>
      </view>
    </view>

    <view class="list" wx:if="!loading">
      <view class="list-item" wx:for="{{suppliers}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
        <view class="item-left">
          <text class="item-title">{{item.supplierName}}</text>
          <text class="item-subtitle">{{item.supplierCode}}</text>
        </view>
        <view class="item-right">
          <text class="status-tag {{getStatusColor(item.status)}}">{{getStatusText(item.status)}}</text>
        </view>
      </view>
      <view class="empty" wx:if="{{suppliers.length === 0}}">
        <text>暂无供应商</text>
      </view>
    </view>

    <view class="loading" wx:if="loading">
      <text>加载中...</text>
    </view>
  </view>

  <view class="bottom-btn">
    <button class="action-btn primary" bindtap="addSupplier">新增供应商</button>
  </view>
</view>