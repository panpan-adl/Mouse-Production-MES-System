.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.search-bar {
  display: flex;
  padding: 20rpx;
  background: #fff;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 24rpx;
}

.search-input {
  height: 80rpx;
  font-size: 28rpx;
}

.search-btn {
  width: 120rpx;
  height: 80rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}

.filter-bar {
  display: flex;
  padding: 20rpx;
  background: #fff;
  gap: 16rpx;
  margin-top: 10rpx;
}

.picker-item {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.clear-btn {
  width: 100rpx;
  height: 72rpx;
  background: #fff;
  border: 1rpx solid #ddd;
  color: #666;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.content {
  padding: 20rpx;
}

.stats-row {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #1890ff;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.item-subtitle {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.item-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #1890ff;
}

.item-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.loading {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
}

.bottom-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  background: #f5f5f5;
  color: #666;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.action-btn.primary {
  background: #1890ff;
  color: #fff;
}