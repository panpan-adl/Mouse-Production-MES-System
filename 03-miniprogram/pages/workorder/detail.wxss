.container {
  padding: 0;
  min-height: 100vh;
  background-color: #f5f7fa;
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.workorder-card {
  background: #fff;
  padding: 24rpx 30rpx;
}

.workorder-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.workorder-no {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.workorder-status {
  font-size: 26rpx;
  font-weight: 500;
  padding: 8rpx 20rpx;
  background: rgba(24, 144, 255, 0.1);
  border-radius: 20rpx;
}

.detail-section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #1890ff;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 26rpx;
  color: #999;
}

.value {
  font-size: 26rpx;
  color: #333;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.action-btn.assign {
  background: #ff9800;
  color: #fff;
}

.action-btn.claim {
  background: #2196f3;
  color: #fff;
}

.action-btn.complete {
  background: #4caf50;
  color: #fff;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.loading-icon {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
