.container {
  padding: 0;
  min-height: 100vh;
  background-color: #f5f7fa;
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx;
  background: #fff;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.search-section {
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  background: transparent;
}

.search-clear {
  font-size: 32rpx;
  color: #999;
  padding: 0 8rpx;
}

.filter-bar {
  background: #fff;
  padding: 12rpx 0;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-inner {
  display: inline-flex;
  padding: 0 20rpx;
  gap: 16rpx;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f7fa;
  border-radius: 24rpx;
  white-space: nowrap;
}

.filter-item.active {
  background: #1890ff;
  color: #fff;
}

.filter-count {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.3);
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
}

.workorder-list {
  display: flex;
  flex-direction: column;
}

.workorder-card {
  background: #fff;
  margin: 0 16rpx 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.workorder-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.workorder-left {
  flex: 1;
}

.workorder-no {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.workorder-tags {
  display: flex;
  gap: 12rpx;
}

.workorder-status {
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.process-tag {
  font-size: 22rpx;
  color: #1890ff;
  background: rgba(24, 144, 255, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.workorder-progress {
  flex-shrink: 0;
}

.progress-ring {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring-text {
  font-size: 18rpx;
  font-weight: 600;
  color: #333;
}

.workorder-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  align-items: center;
}

.info-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  width: 100rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.info-percent {
  font-size: 24rpx;
  font-weight: 600;
}

.progress-bar-section {
  padding: 16rpx 0;
}

.progress-bar-bg {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.workorder-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
}

.owner-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.owner-info.empty {
  opacity: 0.6;
}

.owner-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f7fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.owner-detail {
  display: flex;
  flex-direction: column;
}

.owner-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.owner-role {
  font-size: 22rpx;
  color: #999;
}

.workorder-time {
  font-size: 24rpx;
  color: #999;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.loading-icon {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
