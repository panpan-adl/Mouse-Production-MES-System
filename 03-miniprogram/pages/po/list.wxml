<view class="container">
  <view class="header">
    <text class="title">生产订单</text>
  </view>

  <view class="filter-bar">
    <view 
      class="filter-item {{ statusFilter === item.value ? 'active' : '' }}" 
      wx:for="{{ statusOptions }}" 
      wx:key="value"
      bindtap="onStatusChange"
      data-value="{{ item.value }}"
    >
      {{ item.label }}
    </view>
  </view>

  <view class="order-list" wx:if="{{ !loading && orders.length > 0 }}">
    <view class="order-card" wx:for="{{ orders }}" wx:key="id" bindtap="goToDetail" data-id="{{ item.id }}">
      <view class="order-header">
        <text class="order-no">{{ item.poNo }}</text>
        <view class="order-status" style="color: {{ getStatusColor(item.status) }}; background: {{ getStatusBgColor(item.status) }}">
          {{ getStatusText(item.status) }}
        </view>
      </view>
      <view class="order-info">
        <view class="info-row">
          <text class="info-label">订单编号:</text>
          <text class="info-value">{{ item.orderNo || '-' }}</text>
        </view>
        <view class="info-row">
          <text class="info-label">产品名称:</text>
          <text class="info-value">{{ item.productName || '未知产品' }}</text>
        </view>
        <view class="info-row">
          <text class="info-label">计划数量:</text>
          <text class="info-value">{{ item.planQuantity || 0 }}</text>
        </view>
        <view class="info-row">
          <text class="info-label">完成数量:</text>
          <text class="info-value">{{ item.completedQuantity || 0 }}</text>
        </view>
      </view>
      <view class="order-footer">
        <text class="order-time">{{ formatDate(item.createdAt) }}</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{ !loading && orders.length === 0 }}">
    <view class="empty-icon">📦</view>
    <text class="empty-text">暂无生产订单</text>
  </view>

  <view class="loading" wx:if="{{ loading }}">
    <view class="loading-icon"></view>
    <text>加载中...</text>
  </view>
</view>
