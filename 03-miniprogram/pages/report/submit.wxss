.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f7fa;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
}

.form-picker {
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  color: #999;
}

.form-textarea {
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  height: 160rpx;
}

.form-actions {
  margin-top: 30rpx;
}

.submit-btn {
  width: 100%;
  padding: 24rpx 0;
  background: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn.disabled {
  background: #ccc;
}
